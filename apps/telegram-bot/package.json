{
  "name": "@fisio-li/telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Bot de Telegram (long polling) para que el administrador gestione la agenda en lenguaje natural. Comandos estructurados que funcionan aunque el NLU falle, estado conversacional y confirmación explícita de operaciones sensibles.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env.local dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "precommit": "npm run lint && npm run typecheck && npm test -- --run"
  },
  "dependencies": {
    "grammy": "^1.32.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-security": "^3.0.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.0.0"
  }
}
