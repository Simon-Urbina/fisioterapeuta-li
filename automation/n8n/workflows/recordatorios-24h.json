{
  "id": "fisioRecord24h1",
  "name": "recordatorios-24h",
  "active": true,
  "settings": { "executionOrder": "v1", "timezone": "America/Bogota" },
  "nodes": [
    {
      "id": "cron",
      "name": "Cada 15 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300],
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 15 }] } }
    },
    {
      "id": "reclamar",
      "name": "core-api reclamar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 300],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/recordatorios/reclamar",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Key", "value": "dev-fisio-li-clave-local-2026" }] },
        "options": { "response": { "response": { "neverError": true, "responseFormat": "json" } } }
      }
    },
    {
      "id": "porRec",
      "name": "PorRecordatorio",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [600, 300],
      "parameters": { "fieldToSplitOut": "datos.recordatorios", "options": {} }
    },
    {
      "id": "tieneChat",
      "name": "Tiene chat de Telegram",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [800, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "chat-no-vacio",
              "leftValue": "={{ $json.chatId }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "enviarTG",
      "name": "Enviar a Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1040, 200],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.mensajeTelegram }}",
        "additionalFields": { "appendAttribution": false }
      },
      "credentials": { "telegramApi": { "id": "xqHTHtpRqUjUSwQT", "name": "Telegram account" } }
    },
    {
      "id": "marcarTG",
      "name": "core-api marcar-enviado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 200],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/recordatorios/marcar-enviado",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Key", "value": "dev-fisio-li-clave-local-2026" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"reserva_id\": $('PorRecordatorio').item.json.reservaId, \"paciente_id\": $('PorRecordatorio').item.json.pacienteId, \"ok\": true } }}",
        "options": { "response": { "response": { "neverError": true, "responseFormat": "json" } } }
      }
    },
    {
      "id": "correo",
      "name": "core-api enviar-email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 420],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/recordatorios/enviar-email",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Internal-Key", "value": "dev-fisio-li-clave-local-2026" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"reserva_id\": $('PorRecordatorio').item.json.reservaId, \"paciente_id\": $('PorRecordatorio').item.json.pacienteId } }}",
        "options": { "response": { "response": { "neverError": true, "responseFormat": "json" } } }
      }
    }
  ],
  "connections": {
    "Cada 15 minutos": { "main": [[{ "node": "core-api reclamar", "type": "main", "index": 0 }]] },
    "core-api reclamar": { "main": [[{ "node": "PorRecordatorio", "type": "main", "index": 0 }]] },
    "PorRecordatorio": { "main": [[{ "node": "Tiene chat de Telegram", "type": "main", "index": 0 }]] },
    "Tiene chat de Telegram": {
      "main": [
        [{ "node": "Enviar a Telegram", "type": "main", "index": 0 }],
        [{ "node": "core-api enviar-email", "type": "main", "index": 0 }]
      ]
    },
    "Enviar a Telegram": { "main": [[{ "node": "core-api marcar-enviado", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "meta": null,
  "tags": []
}
